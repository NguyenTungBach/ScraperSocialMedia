NODE_ENV=development
APP_ENV=local
APP_PORT=3400
APP_URL=http://localhost:3400
APP_NAME=ScraperSocialMedia

# Log GCP: GCP_LOG=1 → JSON stdout (không ghi file rotate)
# GCP_LOG=

# PM2: queue = ${PM2_API_NAME}-queue, schedule = ${PM2_API_NAME}-schedule
# PM2_API_NAME=hoyocodes-api
# PM2_NODE_INTERPRETER=node

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tokyo
# true = sample cron chạy mỗi phút (app:sample-ping); mặc định mỗi giờ
SCHEDULE_CHECK=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scraper_social_media
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

FE_URL=http://localhost:3000

# Apify — chỉ cần token (actor ID TikTok/Facebook nằm trong config/apify.js)
# Lấy token tại: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Scrape limits — chung cho YouTube / TikTok / Facebook
SCRAPE_MAX_POSTS=10
SCRAPE_MAX_TOP_COMMENTS=30
SCRAPE_MAX_REPLIES=10

# YouTube Data API v3 — cào video kênh
# Lấy key: Google Cloud Console → APIs & Services → Library → bật YouTube Data API v3
# → Credentials → Create credentials → API key
YOUTUBE_API_KEY=

# Gemini — discover subjects
# Lấy API key: https://aistudio.google.com/apikey
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Fallback khi primary bị high demand / 429 / 503 (cách nhau bằng dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_MS=1200

# Alert — gửi Gmail khi hot_score VÀ trend_score đều >= ngưỡng
ALERT_TREND_THRESHOLD=500
ALERT_HOT_THRESHOLD=800

# Báo cáo so sánh (mail) — % Δ đầu↔cuối kỳ để gắn nhãn up/down/flat
COMPARE_UPTREND_PCT=5
COMPARE_DOWNTREND_PCT=-5

# Slack — (legacy, không dùng nữa)
# Incoming Webhook URL (Apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
# Basic Information → Signing Secret (verify slash commands)
SLACK_SIGNING_SECRET=
# Bảo vệ POST /api/slack-send (header X-Notify-Secret). Để trống = không check.
SLACK_NOTIFY_SECRET=

# Mail: MAIL_MAILER=smtp | ses
# Render/cloud: Gmail SMTP thường timeout — dùng MAIL_MAILER=ses + AWS_SES_* (hoặc để SMTP fail → auto fallback SES nếu có credential)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=
MAIL_MAIN=
# BCC alert (phân tách bằng dấu phẩy hoặc chấm phẩy). Alias: BCC_MAIL
# MAIL_ALERT_BCC=colleague1@example.com,colleague2@example.com

# SES (khi MAIL_MAILER=ses)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_DEFAULT_REGION=ap-northeast-1

# Queue worker poll (ms)
# QUEUE_POLL_INTERVAL_MS=2000
