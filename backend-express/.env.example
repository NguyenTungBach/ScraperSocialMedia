NODE_ENV=development
APP_ENV=local
APP_PORT=3400
APP_URL=http://localhost:3400
APP_NAME=ScraperSocialMedia

# Log GCP: GCP_LOG=1 → JSON stdout (không ghi file rotate)
# GCP_LOG=

# PM2: queue = ${PM2_API_NAME}-queue, schedule = ${PM2_API_NAME}-schedule
# PM2_API_NAME=hoyocodes-api
# PM2_NODE_INTERPRETER=node

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
# Timezone cho PM2 scheduler (general_schedules) + snapshot dates
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Reload lịch từ DB (ms). Mặc định 60000.
# SCHEDULE_RELOAD_MS=60000
# (legacy) sample-ping — không còn dùng bởi scheduler DB
SCHEDULE_CHECK=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scraper_social_media
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=5h

FE_URL=http://localhost:3000

# Apify / YouTube / Gemini / Alert / Mail SMTP — seed vào DB rồi quản lý tại Admin → Settings.
# Giữ trong .env chỉ để chạy seeder lần đầu (npm run db:seed:one -- ...).
# Runtime đọc key_scraps + general_settings (không đọc các biến dưới đây nữa).

# Apify — chỉ cần token (actor ID TikTok/Facebook nằm trong config/apify.js)
# Lấy token tại: https://console.apify.com/account/integrations
# → key_scraps.APIFY_API_TOKEN
APIFY_API_TOKEN=

# YouTube Data API v3 — cào video kênh
# → key_scraps.YOUTUBE_API_KEY
YOUTUBE_API_KEY=

# Gemini — discover subjects / comment analysis
# → key_scraps.GEMINI_*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_MS=1200

# Alert thresholds → general_settings.ALERT_*
ALERT_TREND_THRESHOLD=500
ALERT_HOT_THRESHOLD=800

# Báo cáo so sánh (mail) — % Δ đầu↔cuối kỳ để gắn nhãn up/down/flat
COMPARE_UPTREND_PCT=5
COMPARE_DOWNTREND_PCT=-5

# Slack — (legacy, không dùng nữa)
# Incoming Webhook URL (Apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
# Basic Information → Signing Secret (verify slash commands)
SLACK_SIGNING_SECRET=
# Bảo vệ POST /api/slack-send (header X-Notify-Secret). Để trống = không check.
SLACK_NOTIFY_SECRET=

# Mail SMTP → general_settings.MAIL_* (seed lần đầu từ .env)
# Render/cloud: Gmail SMTP thường timeout — dùng MAIL_MAILER=ses + AWS_SES_*
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=
MAIL_MAIN=
# BCC alert vẫn từ env (không seed vào general_settings)
# MAIL_ALERT_BCC=colleague1@example.com,colleague2@example.com

# SES (khi MAIL_MAILER=ses)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_DEFAULT_REGION=ap-northeast-1

# Queue worker poll (ms)
# QUEUE_POLL_INTERVAL_MS=2000
# Khi start worker: nhả job reserved orphan (0 = tất cả; >0 = chỉ reserved lâu hơn N giây).
# Dùng >0 nếu chạy nhiều worker song song.
# QUEUE_RELEASE_RESERVED_ON_START_SEC=0
# Scraper async status (pending stale / running stale). Requires: npm run queue:worker
# SCRAPER_ASYNC_PENDING_STALE_MS=60000
# SCRAPER_ASYNC_RUNNING_STALE_MS=3600000
# SCRAPER_ASYNC_QUEUE_RESERVED_STALE_SEC=600
