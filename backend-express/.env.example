NODE_ENV=development
APP_ENV=local
APP_PORT=3400
APP_URL=http://localhost:3400
APP_NAME=ScraperSocialMedia

# Log GCP: GCP_LOG=1 → JSON stdout (không ghi file rotate)
# GCP_LOG=

# PM2: queue = ${PM2_API_NAME}-queue, schedule = ${PM2_API_NAME}-schedule
# PM2_API_NAME=hoyocodes-api
# PM2_NODE_INTERPRETER=node

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tokyo
# true = sample cron chạy mỗi phút (app:sample-ping); mặc định mỗi giờ
SCHEDULE_CHECK=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scraper_social_media
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

FE_URL=http://localhost:3000

# Apify — Facebook Posts Scraper
# Lấy token tại: https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# Actor ID mặc định: KoJrdxJCTtpon81KY (facebook-posts-scraper)
APIFY_FACEBOOK_ACTOR_ID=KoJrdxJCTtpon81KY
APIFY_FACEBOOK_RESULTS_LIMIT=5

# Gemini — điền sau khi demo crawl ổn (AI gom tin + quyết định alert)
# Lấy API key: https://aistudio.google.com/apikey
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Alert — ngưỡng score (code tính, AI so sánh sau này)
ALERT_TREND_THRESHOLD=500
ALERT_HOT_THRESHOLD=800

# Slack — (legacy, không dùng nữa)
# Incoming Webhook URL (Apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
# Basic Information → Signing Secret (verify slash commands)
SLACK_SIGNING_SECRET=
# Bảo vệ POST /api/slack-send (header X-Notify-Secret). Để trống = không check.
SLACK_NOTIFY_SECRET=

# Mail: MAIL_MAILER=smtp | ses
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=
MAIL_MAIN=
# BCC_MAIL=

# SES (khi MAIL_MAILER=ses)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_DEFAULT_REGION=ap-northeast-1

# Queue worker poll (ms)
# QUEUE_POLL_INTERVAL_MS=2000
