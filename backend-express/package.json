{
  "name": "scraper-social-media-backend",
  "version": "1.0.0",
  "description": "ScraperSocialMedia Backend — Gemini subjects, Apify scraper, social_posts, Gmail alerts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:ci": "jest --runInBand --ci --detectOpenHandles",
    "queue:worker": "node scripts/queue-worker.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "schedule:worker": "node scripts/scheduler.js",
    "app:sample-ping": "node scripts/run-command.js app:sample-ping",
    "app:alert-gmail": "node scripts/run-command.js app:alert-gmail",
    "app:youtube-refresh-tail": "node scripts/run-command.js app:youtube-refresh-tail",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate-create": "sequelize-cli migration:generate --name",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:one": "sequelize-cli db:seed --seed",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:fresh": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate",
    "db:fresh:seed": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "openapi:generate": "node scripts/generate-openapi.js"
  },
  "keywords": [
    "express",
    "api",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1042.0",
    "apify-client": "^2.25.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "http-errors": "^2.0.0",
    "i18next": "^25.6.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.1.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  }
}
